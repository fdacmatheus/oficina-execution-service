# Valores apenas para o ambiente local (Floci). Nada aqui e segredo real.
NODE_ENV=development
PORT=3003
LOG_FORMAT=json

# JWT HS256 compartilhado com a Lambda de auth. Em producao vem do Secret do k8s.
JWT_SECRET=troque-me-local

# AWS (Floci em localhost:4566). Na AWS remova AWS_ENDPOINT_URL e as credenciais.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

DYNAMODB_TABLE=oficina-execucoes
SQS_EXECUTION_COMANDOS_URL=http://localhost:4566/000000000000/execution-comandos
SQS_OS_EVENTOS_URL=http://localhost:4566/000000000000/os-eventos

SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_INTERVAL_MS=1000

# OpenTelemetry (traces e logs via OTLP/HTTP). Sem esta variavel o tracing fica desligado.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=execution-service
